{
    "name": "Ubuntu Rust Development Container",
    "dockerFile": "Containerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer"
            ]
        }
    },
    "forwardPorts": [
        8000,
        8080
    ],
    "runArgs": [
        "--userns=keep-id",
        "--security-opt=label=disable"
    ]
}
