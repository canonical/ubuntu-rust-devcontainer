ARG UBUNTU_RELEASE=26.10
FROM ubuntu:$UBUNTU_RELEASE AS builder
LABEL org.opencontainers.image.source https://github.com/canonical/ubuntu-rust-devcontainer

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        build-essential pkgconf libssl-dev make clang lld \
        rust-1.97-all cargo rustc rust-clippy rustfmt rust-miri rust-1.97-src rust-1.97-doc \
        vim git curl just bacon xh hx \
        hyperfine ripgrep cargo-auditable cargo-mutants cargo-outdated \
        bash fish \
        autopkgtest dh-make dh-cargo git-buildpackage sbuild ubuntu-dev-tools devscripts \
    && cargo install --locked --root /usr cargo-audit cargo-deny cargo-vet cargo-vendor-filterer ubucargo lpcli \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

USER root

EXPOSE 8000 8080

ENTRYPOINT [ "/usr/bin/fish" ]
