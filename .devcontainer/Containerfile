ARG UBUNTU_RELEASE=26.04
FROM ubuntu:$UBUNTU_RELEASE AS builder
LABEL org.opencontainers.image.source https://github.com/canonical/ubuntu-rust-devcontainer

ARG RUST_VERSION=1.97
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        build-essential pkgconf libssl-dev make clang lld \
        rust-${RUST_VERSION}-all rust-${RUST_VERSION}-gdb rust-${RUST_VERSION}-lldb rust-${RUST_VERSION}-src rust-${RUST_VERSION}-doc \
        vim git curl just bacon xh hx \
        hyperfine ripgrep cargo-auditable cargo-mutants cargo-outdated \
        bash fish \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/cargo /usr/bin/cargo \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/cargo-clippy /usr/bin/cargo-clippy \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/cargo-fmt /usr/bin/cargo-fmt \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/cargo-miri /usr/bin/cargo-miri \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/clippy-driver /usr/bin/clippy-driver \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/miri /usr/bin/miri \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/rust-gdb /usr/bin/rust-gdb \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/rust-lldb /usr/bin/rust-lldb \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/rustc /usr/bin/rustc \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/rustdoc /usr/bin/rustdoc \
    && ln -s /usr/lib/rust-${RUST_VERSION}/bin/rustfmt /usr/bin/rustfmt \
    && cargo install --locked --root /usr cargo-audit cargo-deny cargo-vet \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

USER root

EXPOSE 8000 8080

ENTRYPOINT [ "/usr/bin/fish" ]
